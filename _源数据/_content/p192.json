ue}, "Data:Fatiguing.ability.json": {"id": "fatiguing.ability", "label": "fatigue an ability", "desc": "(recipe aspect)", "isAspect": true, "noartneeded": true}, "Data:Fatiguing.beverage.json": {"id": "fatiguing.beverage", "label": "Target drinks specifically", "desc": "(recipe aspect)", "isAspect": true, "noartneeded": true}, "Data:Fatiguing.ingredients.json": {"id": "fatiguing.ingredients", "label": "Use up a wide variety of items", "desc": "(recipe aspect)", "isAspect": true, "noartneeded": true}, "Data:Fatiguing.json": {"id": "fatiguing", "label": "fatiguing", "desc": "(recipe aspect)", "isAspect": true, "noartneeded": true}, "Data:Fatiguing.memory.json": {"id": "fatiguing.memory", "label": "fatigue a memory", "desc": "(recipe aspect)", "isAspect": true, "noartneeded": true}, "Data:Fatiguing.spintria.json": {"id": "fatiguing.spintria", "desc": "(recipe aspect)", "isAspect": true, "noartneeded": true}, "Data:Fatiguing.sustenance.json": {"id": "fatiguing.sustenance", "label": "Target food specifically", "desc": "(recipe aspect)", "isAspect": true, "noartneeded": true}, "Data:Fear.carapace.json": {"id": "fear.carapace", "label": "Fear: Carapace", "desc": "This one knows that the Carapace might consume humanity - or alter it beyond recognition.", "isaspect": true}, "Data:Fear.chandler.json": {"id": "fear.chandler", "label": "Fear: Chandler", "desc": "This one knows the dangers in the Chandler's coming.", "isaspect": true}, "Data:Fear.devourers.json": {"id": "fear.devourers", "label": "Fear: Devourers", "desc": "This one knows the perils of the hidden world: alukites, Mansus-spirits, hungry ghosts...", "isaspect": true}, "Data:Fear.nowhere.json": {"id": "fear.nowhere", "label": "Fear: Nowhere", "desc": "This one understands the all-consuming horror of the gods-from-Nowhere.", "isaspect": true}, "Data:Fear.ys.json": {"id": "fear.ys", "label": "Fear: Ys", "desc": "This one knows the peril of Ys' seductions.", "isaspect": true}}